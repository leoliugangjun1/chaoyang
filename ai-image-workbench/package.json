{
  "name": "ai-image-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "typecheck": "node --check server/index.js && node --check server/runtime.js && node --check public/app.js && node --check public/action-variation.js",
