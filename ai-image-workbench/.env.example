# Copy to .env on the server. Never commit .env.
HOST=127.0.0.1
PORT=4189
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
OPENLUX_API_KEY=
OPENLUX_BASE_URL=https://api.openlux.ai/v1
OPENLUX_IMAGE_MODEL=gemini-2.5-flash-image
DEFAULT_IMAGE_PROVIDER=image2
MAX_CONCURRENCY=10
GENERATION_CONCURRENCY=10
# Optional: plugin packages live outside the workbench product directory.
# WORKBENCH_PLUGIN_ROOT=../ai-workbench-plugins
